<Page x:Class="UiDesktopApp1.Views.Pages.LienHe.KhachHangPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages.LienHe" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
      xmlns:lienhe="clr-namespace:UiDesktopApp1.ViewModels.Pages.LienHe" 
      xmlns:models="clr-namespace:UiDesktopApp1.Models" d:DataContext="{d:DesignInstance Type=lienhe:KhachHangViewModel}"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors"
      mc:Ignorable="d" 
      d:DesignWidth="800"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      Title="KhachHangPage">

    <Page.Resources>
        <ResourceDictionary>
            <beh:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,0.5,0">
                <Grid Width="300" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="480"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,0.5">
                        <ui:AutoSuggestBox Icon="{ui:SymbolIcon Search24}" 
                                           PlaceholderText="Tìm kiếm theo tên" Margin="10,10,10,20"
                                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           />
                    </Border>
                    <Grid Grid.Row="1">
                        <ui:ListView d:ItemsSource="{d:SampleData ItemCount=5}"
                                     ItemsSource="{Binding CustomersView}"
                                     SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}">
                            <b:Interaction.Behaviors>
                                <beh:ScrollIntoViewBehavior SelectedItem="{Binding SelectedSupplier}"/>
                            </b:Interaction.Behaviors>
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CustomerModel}">
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Ellipse"
                                                 Grid.RowSpan="2"
                                                 Width="32"
                                                 Height="32"
                                                 Margin="6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Fill="{ui:ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   Margin="5,0,0,0"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name, Mode=OneWay}"/>
                                    </Grid>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid Margin="15,15,50,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Vertical">
                                <ui:TextBlock Text="{Binding SelectedCustomer.Name}" FontSize="30"
                                              FontWeight="SemiBold"/>
                            </StackPanel>

                            <ui:Button Grid.Column="1" Margin="10,0,10,0"
                                       Width="50" Height="40"
                                       Command="{Binding DeleteCommand}"
                                       CornerRadius="10"
                                       MouseOverBackground="LightBlue"
                                       Appearance="Danger">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" FontWeight="Bold"
                                                   FontSize="20"/>
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Grid.Column="2" Margin="5,0,10,0"
                                       Width="50" Height="40"
                                       Command="{Binding EditCommand}"
                                       CornerRadius="10"
                                       MouseOverBackground="LightBlue"
                                       Appearance="Primary">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" FontWeight="Bold"
                                                   FontSize="20"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Height="476" Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  VerticalAlignment="Top"
                                  Padding="0,0,10,0">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,10,0,5" Visibility="{Binding SelectedCustomer.PhoneNumber, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Call24" FontSize="18" Margin="0,3,10,0" Grid.Column="0" VerticalAlignment="Top" Foreground="DeepSkyBlue" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Số điện thoại" FontWeight="SemiBold" FontSize="14" Opacity="0.7"/>
                                    <TextBlock Text="{Binding SelectedCustomer.PhoneNumber}" FontSize="18" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,5" Visibility="{Binding SelectedCustomer.Address, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Location24" FontSize="18" Margin="0,3,10,0" Grid.Column="0"          VerticalAlignment="Top" Foreground="DeepSkyBlue" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Địa chỉ" FontWeight="SemiBold" FontSize="14" Opacity="0.7"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Address}" FontSize="18" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,5" Visibility="{Binding SelectedCustomer.Notes, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Note24" FontSize="18" Margin="0,3,10,0" Grid.Column="0" VerticalAlignment="Top" Foreground="DeepSkyBlue" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Ghi chú" FontWeight="SemiBold" FontSize="14" Opacity="0.7"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Notes}" FontSize="18" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.9"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
