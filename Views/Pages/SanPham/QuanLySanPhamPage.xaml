<Page x:Class="UiDesktopApp1.Views.Pages.SanPham.QuanLySanPhamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages.SanPham"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors" 
      xmlns:sanpham="clr-namespace:UiDesktopApp1.ViewModels.Pages.SanPham" d:DataContext="{d:DesignInstance Type=sanpham:QuanLySanPhamViewModel}"
      mc:Ignorable="d" 
      ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False"
      Title="QuanLySanPhamPage">

    <Page.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
    </Page.InputBindings>
    
    <Border>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:TextBox Width="200" Height="36" Margin="0,0,10,0"
                         PlaceholderText="Tìm kiếm"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Command="{Binding SearchCommand}"
                               Margin="0,0,10,0"
                               Height="35"
                               ToolTip="Tìm kiếm"
                               MouseOverBackground="LightBlue"
                               Icon="{ui:SymbolIcon Symbol=Search24}"
                               Appearance="Primary"/>
                    <ComboBox Width="200" Height="36" ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                  DisplayMemberPath="Name" Margin="0,0,10,0" />
                    <ui:Button Command="{Binding LoadDataCommand}"  
                               Width="36" Height="36"
                               Icon="{ui:SymbolIcon ArrowClockwise20}"
                               ToolTip="Làm mới dữ liệu"
                               MouseOverBackground="LightBlue"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"  Margin="0,0,0,10" 
                            Visibility="{Binding SelectedCount, Converter={x:Static beh:ZeroToCollapsedConverter.Instance}}">
                    <ui:TextBlock Text="{Binding SelectedCount, StringFormat='Đã chọn {0} sản phẩm'}" 
                                  FontWeight="Bold"         
                                  VerticalAlignment="Center" />
                    <ui:Button Content="Hủy chọn" 
                               MouseOverBackground="LightBlue"
                               Command="{Binding SelectAllCommand}" Margin="10,0" />
                    <ui:Button Content="Xóa đã chọn" 
                               MouseOverBackground="LightBlue"
                               Command="{Binding DeleteSelectedCommand}" 
                               Margin="10,0"
                               Appearance="Danger"
                               />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1">
                <ui:DataGrid ItemsSource="{Binding ProductsView}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"    
                             CanUserResizeColumns="True"
                             CanUserResizeRows="False"
                             CanUserReorderColumns="False"
                             IsReadOnly="True"
                             SelectionMode="Extended"
                             SelectionUnit="FullRow"
                             HeadersVisibility="All"
                             RowHeight="56"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                             BorderThickness="1"
                             BorderBrush="#DDD">

                    <ui:DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                        </Style>
                    </ui:DataGrid.CellStyle>

                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllItemsSelected, 
                                                               RelativeSource={RelativeSource AncestorType={x:Type local:QuanLySanPhamPage}}, 
                                                               Mode=TwoWay, 
                                                               UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Hình ảnh" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="4">
                                        <ui:Image Source="{Binding Image}"
                                               Width="48"
                                               Height="48"
                                               CornerRadius="10" BorderBrush="#33000000"
                                               Stretch="UniformToFill"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               ClipToBounds="True"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã số" Binding="{Binding ProductCode}" Width="100" />
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Giá bán" Binding="{Binding SalePrice, StringFormat={}{0:N0}}" Width="Auto" />
                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Category.Name}" Width="120" />
                        <DataGridTextColumn Header="Hết hạn" Binding="{Binding ExpiryDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue='--'}" Width="Auto" />

                        <DataGridTemplateColumn Header="Sửa" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Sửa"
                                               Icon="Pen24"
                                               Appearance="Transparent"
                                               MouseOverBackground="LightBlue"
                                               Command="{Binding DataContext.EditProductCommand, 
                                                                 RelativeSource={RelativeSource AncestorType={x:Type local:QuanLySanPhamPage}}}"
                                               CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>
            <ui:ProgressRing IsIndeterminate="True" 
                             Grid.Row="1"
                             Visibility="{Binding IsBusy, Converter={x:Static beh:BooleanToVisibilityConverter.Instance}}"
                             Width="50" Height="50" 
                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Page>