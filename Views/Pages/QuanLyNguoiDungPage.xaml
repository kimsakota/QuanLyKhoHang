<Page x:Class="UiDesktopApp1.Views.Pages.QuanLyNguoiDungPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:UiDesktopApp1.Models" 
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors" xmlns:pages="clr-namespace:UiDesktopApp1.ViewModels.Pages" d:DataContext="{d:DesignInstance Type=pages:QuanLyNguoiDungViewModel}"
      mc:Ignorable="d" 
      ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False"
      Title="QuanLyNguoiDungPage">
    
    
    <Grid Margin="16">
        <ui:DataGrid ItemsSource="{Binding Users}"
                     SelectedItem="{Binding SelectedUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"    
                     CanUserResizeColumns="False"
                     CanUserResizeRows="False"
                     CanUserReorderColumns="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     HeadersVisibility="All"
                     RowHeight="40"
                     Background="{ui:ThemeResource SubtleFillColorSecondaryBrush}"
                     BorderThickness="1"
                     BorderBrush="#DDD">
            <b:Interaction.Behaviors>
                <beh:ScrollIntoViewBehavior SelectedItem="{Binding SelectedUser}"/>
            </b:Interaction.Behaviors>
            <ui:DataGrid.TextColumnElementStyle>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
            </ui:DataGrid.TextColumnElementStyle>

            <ui:DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                </Style>
            </ui:DataGrid.CellStyle>

            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Tên người dùng" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding PhoneNumber}" Width="Auto" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="Auto" />
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="Auto" />
                <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="Auto" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</Page>
