<Page x:Class="UiDesktopApp1.Views.Pages.NhapKhoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance local:NhapKhoPage,
                                 IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NhapKhoPage">
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="400"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Báo cáo tài chính" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Tổng quan tình hình kinh doanh 6 tháng đầu năm" Opacity="0.6"/>
            </StackPanel>

            <ui:CardControl Grid.Row="1" Margin="0,0,0,20">
                <ui:CardControl.Header>
                    <TextBlock Text="Doanh thu và Chi phí (Triệu đồng)" FontWeight="SemiBold" FontSize="16"/>
                </ui:CardControl.Header>

                <lvc:CartesianChart 
                    Series="{Binding RevenueSeries}"
                    XAxes="{Binding RevenueXAxes}"
                    YAxes="{Binding RevenueYAxes}"
                    LegendPosition="Top">
                </lvc:CartesianChart>
            </ui:CardControl>

            <TextBlock Grid.Row="2" Text="Phân tích chi phí" FontSize="20" FontWeight="Bold" Margin="0,10,0,10"/>

            <ui:CardControl Grid.Row="3">
                <ui:CardControl.Header>
                    <TextBlock Text="Tỷ trọng các loại chi phí" FontWeight="SemiBold" FontSize="16"/>
                </ui:CardControl.Header>

                <lvc:PieChart 
                    Series="{Binding CostPieSeries}"
                    LegendPosition="Right"
                    InitialRotation="-90">
                </lvc:PieChart>
            </ui:CardControl>

        </Grid>
    </Grid>


</Page>
