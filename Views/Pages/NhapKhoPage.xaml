<Page x:Class="UiDesktopApp1.Views.Pages.NhapKhoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
      xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors"
      xmlns:models="clr-namespace:UiDesktopApp1.Models"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="NhapKhoPage"
      ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <beh:NumberVnConverter x:Key="NumberVnConverter"/>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                Margin="0,0,12,0" Padding="16">

            <StackPanel>
                <TextBlock Text="Chi tiết nhập hàng" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBlock Text="Sản phẩm" FontWeight="Medium" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="ProductName"
                          
                          IsEditable="True"
                          Margin="0,0,0,12"
                          HorizontalAlignment="Stretch"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Mã SP" Foreground="Gray" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedProduct.ProductCode, Mode=OneWay}" 
                                 IsReadOnly="True" Background="Transparent"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Đơn vị" Foreground="Gray" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="Cái" IsReadOnly="True" Width="60" TextAlignment="Center" Background="Transparent"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Đơn giá nhập" FontWeight="Medium" Margin="0,0,0,6"/>
                <ui:TextBox PlaceholderText="0"
                            Text="{Binding InputPrice, Mode=TwoWay, Converter={StaticResource NumberVnConverter}, UpdateSourceTrigger=PropertyChanged}"
                            beh:TextBoxBehaviors.SelectAllOnFocus="True"
                            Margin="0,0,0,12"/>

                <TextBlock Text="Số lượng" FontWeight="Medium" Margin="0,0,0,6"/>
                <ui:NumberBox PlaceholderText="0"
                              Value="{Binding InputQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Minimum="1"
                              
                              Margin="0,0,0,24"/>

                <ui:Button Content="Thêm vào phiếu" 
                           Appearance="Primary" 
                           Icon="AddCircle24"
                           Command="{Binding AddToImportListCommand}"
                           HorizontalAlignment="Stretch" Height="40"/>

                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="Red" 
                           TextWrapping="Wrap" 
                           Margin="0,10,0,0"
                           />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:DataGrid Grid.Row="0"
                         ItemsSource="{Binding ImportDetails}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         HeadersVisibility="Column"
                         BorderThickness="1"
                         BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                         RowHeight="45">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding Product.ProductCode}" Width="80"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Product.ProductName}" Width="*"/>

                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="80"/>

                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="100"/>

                    <DataGridTextColumn Header="Thành tiền" 
                                        Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" 
                                        FontWeight="Bold"
                                        Width="120"/>

                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Icon="Delete24" 
                                           Appearance="Transparent"
                                           Foreground="#D13438"
                                           Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <Border Grid.Row="1" 
                    Margin="0,12,0,0" 
                    Padding="16" 
                    Background="{ui:ThemeResource ControlFillColorSecondaryBrush}" 
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Calculator24" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ImportDetails.Count, StringFormat='Tổng số mặt hàng: {0}'}" 
                                   FontStyle="Italic" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="TỔNG CỘNG:" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} VNĐ}" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>