<Page x:Class="UiDesktopApp1.Views.Pages.BaoCao.TonKhoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages.BaoCao"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors"
      xmlns:viewmodels="clr-namespace:UiDesktopApp1.ViewModels.Pages.BaoCao"
      d:DataContext="{d:DesignInstance Type=viewmodels:TonKhoViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      Title="Báo cáo tồn kho">

    <Page.Resources>
        <beh:NumberVnConverter x:Key="NumberVnConverter"/>
        <beh:NumberToColorConverter x:Key="NumberToColorConverter"/>
        <beh:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Padding="15"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Box24" FontSize="28" Foreground="CornflowerBlue" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalProductsCount}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="Mặt hàng" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" Padding="15"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <ui:SymbolIcon Symbol="NumberSymbol24" FontSize="28" Foreground="Orange" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalStockQuantity, StringFormat=N0}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock Text="Đơn vị sản phẩm" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" CornerRadius="8" Padding="15"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <ui:SymbolIcon Symbol="MoneyCalculator24" FontSize="28" Foreground="ForestGreen" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalStockValue, StringFormat={}{0:N0} đ}" FontSize="22" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Tổng giá trị kho" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" CornerRadius="8" Padding="15"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Warning24" FontSize="28" Foreground="Red" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Margin="0,5,0,0" Foreground="Red"/>
                    <TextBlock Text="Cần nhập thêm" Foreground="Gray"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" 
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="15">
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Warning24" Foreground="OrangeRed" Margin="0,0,10,0"/>
                            <TextBlock Text="Cảnh báo nhập hàng" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ui:DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}"
                                 AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                 HeadersVisibility="Column" BorderThickness="0"
                                 GridLinesVisibility="Horizontal"
                                 Visibility="{Binding LowStockCount, Converter={StaticResource ZeroToCollapsedConverter}}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTemplateColumn Header="SL" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#20FF0000" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding InitialQty}" FontWeight="Bold" Foreground="Red"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding LowStockCount, Converter={StaticResource ZeroToCollapsedConverter}, ConverterParameter=Inverse}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" Foreground="ForestGreen" Margin="0,0,0,15"/>
                        <TextBlock Text="Tuyệt vời!" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kho hàng đang ở mức an toàn" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" 
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="0">
                <TabControl>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowTrendingLines24" Margin="0,0,8,0"/>
                                <TextBlock Text="Top giá trị tồn"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top 5 sản phẩm chiếm vốn cao nhất" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <lvc:CartesianChart Grid.Row="1" 
                                                Series="{Binding TopValueSeries}" 
                                                XAxes="{Binding TopValueXAxes}"
                                                YAxes="{Binding TopValueYAxes}"
                                                TooltipPosition="Top">
                            </lvc:CartesianChart>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataPie24" Margin="0,0,8,0"/>
                                <TextBlock Text="Cơ cấu danh mục"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tỷ trọng giá trị theo nhóm hàng" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <lvc:PieChart Grid.Row="1" 
                                          Series="{Binding CategoryValueSeries}" 
                                          LegendPosition="Right"
                                          TooltipPosition="Center"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" Visibility="{Binding IsBusy, Converter={x:Static beh:BooleanToVisibilityConverter.Instance}}"
              Background="#80000000">
            <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>