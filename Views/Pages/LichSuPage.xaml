<Page x:Class="UiDesktopApp1.Views.Pages.LichSuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:UiDesktopApp1.Views.Pages"
      xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors" 
      xmlns:pages="clr-namespace:UiDesktopApp1.ViewModels.Pages"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance pages:LichSuViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="650" d:DesignWidth="1000"
      ScrollViewer.CanContentScroll="False"
      ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
      Title="Lịch sử giao dịch">

    <Page.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
    </Page.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Margin="0,0,0,15"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="8" 
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
                        <ui:CalendarDatePicker Date="{Binding StartDate, Mode=TwoWay}" 
                                               Icon="{ui:SymbolIcon Symbol=CalendarEdit24}"
                                               Width="30" Height="30"
                                               MouseOverBackground="LightBlue"
                                               Padding="0"
                                               HorizontalContentAlignment="Center"
                                               ToolTip="Chọn ngày bắt đầu">
                        </ui:CalendarDatePicker>

                        <ui:TextBlock Text="{Binding StartDate, StringFormat='dd/MM/yyyy'}" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0" 
                                      FontWeight="Medium"
                                      FontSize="14"/>   
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:CalendarDatePicker Date="{Binding EndDate, Mode=TwoWay}" 
                                               Icon="{ui:SymbolIcon Symbol=CalendarEdit24}"
                                               Width="30" Height="30"
                                               MouseOverBackground="LightBlue"
                                               Padding="0"
                                               HorizontalContentAlignment="Center"
                                               ToolTip="Chọn ngày kết thúc">
                        </ui:CalendarDatePicker>

                        <ui:TextBlock Text="{Binding EndDate, StringFormat='dd/MM/yyyy'}" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0" 
                                      FontWeight="Medium"
                                      FontSize="14"/>       
                    </StackPanel>

                </StackPanel>

                <ComboBox Grid.Column="1" Width="140" SelectedIndex="{Binding SelectedTypeIndex, Mode=TwoWay}" Margin="0,0,15,0">
                    <ComboBoxItem Content="Tất cả loại"/>
                    <ComboBoxItem Content="Nhập kho"/>
                    <ComboBoxItem Content="Xuất kho"/>
                    <ComboBoxItem Content="Kiểm kê kho"/>
                </ComboBox>

                <ui:TextBox Grid.Column="3" PlaceholderText="Tìm mã phiếu, đối tác..." 
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,10,0"/>

                <ui:Button Grid.Column="4" Content="Lọc dữ liệu" 
                           Icon="{ui:SymbolIcon Filter24}" 
                           Appearance="Primary" 
                           MouseOverBackground="LightBlue"
                           Command="{Binding LoadDataCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ui:DataGrid ItemsSource="{Binding HistoryList}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         IsReadOnly="True"
                         HeadersVisibility="All"
                         RowHeight="48">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phiếu" Binding="{Binding TransactionCode}" Width="110" FontWeight="SemiBold"/>

                    <DataGridTemplateColumn Header="Loại phiếu" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                        Background="{Binding Type, Converter={x:Static beh:StringToColorConverter.Instance}}">
                                    <TextBlock Text="{Binding Type}" FontWeight="Medium" Foreground="#333"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                    <DataGridTextColumn Header="Đối tác / Ghi chú" Binding="{Binding PartnerName}" Width="*"/>

                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ, TargetNullValue='--'}" Width="130" FontWeight="Bold"/>

                    <DataGridTextColumn Header="Người tạo" Binding="{Binding Creator}" Width="130"/>

                    <DataGridTemplateColumn Header="Chi tiết" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Icon="{ui:SymbolIcon Eye24}"
                                           Appearance="Transparent"
                                           ToolTip="Xem chi tiết"
                                           MouseOverBackground="LightBlue"
                                           Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</Page>