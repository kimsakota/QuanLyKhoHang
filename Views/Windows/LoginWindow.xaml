<Window x:Class="UiDesktopApp1.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:UiDesktopApp1.Views.Windows"
        xmlns:windows="clr-namespace:UiDesktopApp1.ViewModels.Windows"
        d:DataContext="{d:DesignInstance Type=windows:LoginViewModel}"
        mc:Ignorable="d"
        Title="LoginWindow" 
        Height="450" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"          
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding ExitCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>

    <Border CornerRadius="0,30,30,0"       
        BorderBrush="#3B82F6"
            BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#1D4ED8" Offset="0.5"/>
                <GradientStop Color="#4F46E5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Vòng tròn trang trí ở góc phải -->
            <Ellipse Width="220" Height="220"
                     Fill="#22FFFFFF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-80,-80,0"/>

            <Ellipse Width="140" Height="140"
                     Stroke="#33FFFFFF"
                     StrokeThickness="2"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-40,-60"/>

            <Border CornerRadius="0,28,28,0"
                    Background="#CC0B1120"   
                    Margin="0">
                <Grid Margin="40"
                      Opacity="{Binding IsLoggingIn, Converter={x:Static beh:InverseBooleanConverter.Instance}, ConverterParameter=0.5, FallbackValue=1.0}"
                      IsEnabled="{Binding IsLoggingIn, Converter={x:Static beh:InverseBooleanConverter.Instance}, FallbackValue=True}">

                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Image Source="/Assets/Images/Logos/logo.png"
                               Width="120" Margin="0,0,0,10"
                               Stretch="Uniform"
                               Opacity="0.85"/>

                        <ui:TextBlock Text="QUẢN LÝ KHO"
                                      Foreground="White"
                                      FontSize="26"
                                      FontWeight="SemiBold"
                                      FontFamily="Segoe UI Semibold"
                                      HorizontalAlignment="Center"/>

                        <ui:TextBlock Text="Đăng nhập để tiếp tục"
                                      Opacity="0.8"
                                      Foreground="#D1D5DB"
                                      FontSize="13"
                                      FontWeight="Normal"
                                      FontFamily="Segoe UI"
                                      HorizontalAlignment="Center"
                                      Margin="0,5,0,25"/>

                        <!-- Tài khoản -->
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Person16"
                                           Foreground="White"
                                           Margin="0,0,5,0"
                                           FontSize="20"/>
                            <ui:TextBlock Text="Tài khoản"
                                          Foreground="#9CA3AF"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          FontFamily="Segoe UI"/>
                        </DockPanel>

                        <ui:TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,5,0,12"
                                    PlaceholderText="Nhập tài khoản"
                                    MinWidth="200"/>

                        <!-- Mật khẩu -->
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Password16"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"
                                           FontSize="20"/>
                            <ui:TextBlock Text="Mật khẩu"
                                          Foreground="#9CA3AF"
                                          FontSize="14"
                                          FontWeight="Medium"
                                          FontFamily="Segoe UI"/>
                        </DockPanel>

                        <ui:PasswordBox x:Name="PasswordBox"
                                        PlaceholderText="Nhập mật khẩu"
                                        Margin="0,5,0,0"
                                        PasswordChanged="PasswordBox_PasswordChanged"/>

                        <!-- Error -->
                        <ui:TextBlock Text="{Binding ErrorMessage}"
                                      Foreground="#F97373"
                                      FontSize="12"
                                      Margin="0,10,0,0"
                                      TextWrapping="Wrap"
                                      Visibility="{Binding ErrorMessage, Converter={x:Static beh:StringNullOrEmptyToVisibilityConverter.Instance}}"/>

                        <!-- Button Đăng nhập -->
                        <ui:Button Appearance="Primary"
                                   Content="ĐĂNG NHẬP"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Width="Auto" MinWidth="170" Height="40"
                                   Padding="30,0"
                                   CornerRadius="12"
                                   Cursor="Hand"
                                   Margin="0,25,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Command="{Binding LoginCommand}"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading -->
            <ui:ProgressRing IsIndeterminate="True"
                             Width="40" Height="40"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Visibility="{Binding IsLoggingIn, Converter={x:Static beh:BooleanToVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>

            <!-- Nút close -->
            <ui:Button Command="{Binding ExitCommand}"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       Margin="10"
                       Background="Transparent"
                       Foreground="White"
                       Cursor="Hand"
                       CornerRadius="999">
                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/>
            </ui:Button>

        </Grid>
    </Border>
</Window>
