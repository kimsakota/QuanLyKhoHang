<ui:FluentWindow
    x:Class="UiDesktopApp1.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UiDesktopApp1.Views.Windows"
    xmlns:helpers="clr-namespace:UiDesktopApp1.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    MinWidth="1100" MinHeight="650"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    ResizeMode="CanResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="0,0,0,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FooterMenuItemsSource="{Binding FooterMenuItems, Mode=OneWay}"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            IsPaneOpen="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            OpenPaneLength="200"
            MenuItemsSource="{Binding MenuItems, Mode=OneWay}"
            PaneDisplayMode="Left">
            <ui:NavigationView.Header>
                <!--<ui:BreadcrumbBar x:Name="BreadcrumbBar" Margin="42,32,42,20" />-->
                <ContentControl Content="{Binding CurrentPageHeader, Mode=OneWay}"/>
            </ui:NavigationView.Header>

            <ui:NavigationView.ContentOverlay >
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>

            <ui:NavigationView.PaneFooter>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Flyout Grid.Row="0"
                               IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                               Placement="Top">
                        <StackPanel>
                            <TextBlock Width="280"
                                       HorizontalAlignment="Left"
                                       Text="Replicants like any other machine are either a benefit or a hazard. If they're a benefit it's not my problem."
                                       TextWrapping="WrapWithOverflow" />      
                            <Button Margin="0,8,0,0" Content="The cake is a lie!" />
                        </StackPanel>
                    </ui:Flyout>
                    <ui:Button Grid.Row="1"
                               Command="{Binding ButtonClickCommand, Mode=OneWay}"
                               CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                               MaxWidth="200"
                               MouseOverBackground="LightGray"
                               HorizontalContentAlignment="Left"
                               >
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonCircle24" 
                                           FontSize="24"
                                           />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
