<ui:FluentWindow
    x:Class="UiDesktopApp1.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UiDesktopApp1.Views.Windows"
    xmlns:helpers="clr-namespace:UiDesktopApp1.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    d:DataContext="{d:DesignInstance local:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    MinWidth="1100" MinHeight="650"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    ResizeMode="CanResize">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Padding="0,0,0,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FooterMenuItemsSource="{Binding FooterMenuItems, Mode=OneWay}"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            IsPaneOpen="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            OpenPaneLength="200"
            MenuItemsSource="{Binding MenuItems, Mode=OneWay}"
            PaneDisplayMode="Left">
            <ui:NavigationView.Header>
                <!--<ui:BreadcrumbBar x:Name="BreadcrumbBar" Margin="42,32,42,20" />-->
                <ContentControl Content="{Binding CurrentPageHeader, Mode=OneWay}"/>
            </ui:NavigationView.Header>

            <ui:NavigationView.ContentOverlay >
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter"/>
                </Grid>
            </ui:NavigationView.ContentOverlay>

            <ui:NavigationView.PaneFooter>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Flyout Grid.Row="0"
                               IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                               BorderBrush="LightGray"
                               BorderThickness="0.5"
                               Placement="Top">
                        <StackPanel Width="175">
                            <ui:Button Content="Cài đặt"
                                       Command="{Binding NavigateToSettingsCommand}"
                                       Appearance="Transparent"
                                       HorizontalContentAlignment="Left"
                                       BorderThickness="0"
                                       Margin="-6,0,-6,0"
                                       Height="40"
                                       HorizontalAlignment="Stretch"
                                       MouseOverBackground="LightGray">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Settings24"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>
                                </ui:Button.Icon>
                            </ui:Button>

                            <ui:Button Content="Đăng xuất"
                                       Command="{Binding LogOutCommand}"
                                       Appearance="Transparent"
                                       HorizontalContentAlignment="Left"
                                       BorderThickness="0"
                                       Margin="-6,0,-6,-6"
                                       Height="40"
                                       HorizontalAlignment="Stretch"
                                       MouseOverBackground="LightGray">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowExit20"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </ui:Flyout>
                    <ui:Button Grid.Row="1"
                               Command="{Binding ButtonClickCommand, Mode=OneWay}"
                               CommandParameter="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}"
                               Content="{Binding CurrentUserName, Mode=OneWay}"
                               HorizontalAlignment="Stretch"
                               MouseOverBackground="LightGray"
                               Margin="-5,0,-5,0"
                               Appearance="Transparent">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PersonCircle24" Margin="-1,0,0,0"
                                           FontSize="27"
                                           Foreground="DeepSkyBlue"
                                           />     
                        </ui:Button.Icon>

                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="12,8,12,8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=RootNavigation, Path=IsPaneOpen}" Value="False">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0,8,0,8" />

                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <ContentPresenter
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
