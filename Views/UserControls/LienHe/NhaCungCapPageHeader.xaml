<UserControl x:Class="UiDesktopApp1.Views.UserControls.LienHe.NhaCungCapPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UiDesktopApp1.Views.UserControls.LienHe"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             >
    <Border BorderBrush="LightGray" BorderThickness="0,0,0,0.5">
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nhà cung cấp"
           Grid.Column="0"
           VerticalAlignment="Center"
           FontSize="24"
           FontWeight="SemiBold"
           Margin="20,10,0,10"/>
            <StackPanel Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
                <ui:Button Content="Nhà cung cấp" 
                    Command="{Binding AddCommand}"
                    Appearance="Primary"
                    Margin="5,10,15,10"> 
                    <ui:Button.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="AddCircle12"/>
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
