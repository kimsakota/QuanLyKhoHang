<ContentControl x:Class="UiDesktopApp1.Views.UserControls.LienHe.ThemKhachHangDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UiDesktopApp1.Views.UserControls.LienHe"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors"
             mc:Ignorable="d" 
             d:DesignWidth="400">
    <StackPanel Margin="16">
        

        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Tên khách hàng" FontWeight="SemiBold"/>
            <TextBlock Text=" *(Bắt buộc)" Foreground="DarkRed" Margin="0,0,0,5"/>
            <ui:TextBox 
                PlaceholderText="Nhập tên khách hàng"
                Text="{Binding Customer.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ui:TextBox 
                PlaceholderText="Nhập số điện thoại"
                Text="{Binding Customer.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Địa chỉ" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ui:TextBox 
                PlaceholderText="Nhập địa chỉ"
                Text="{Binding Customer.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <ui:InfoBar Margin="0,10,0,0"
                    Severity="Error"
                    Title="Dữ liệu chưa hợp lệ"
                    Message="{Binding ErrorSummary, Mode=OneWay}"
                    IsOpen="{Binding Customer.HasErrors}"
                    IsClosable="False"/>

        <ui:InfoBar Margin='0,5,0,0'
                    Severity="Informational"
                    Message="Đang xử lý, vui lòng chờ..."
                    IsOpen="{Binding IsBusy}"
                    IsClosable="False" />

    </StackPanel>
</ContentControl>
