<UserControl x:Class="UiDesktopApp1.Views.UserControls.QuanLyNguoiDungPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UiDesktopApp1.Views.UserControls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors" 
             xmlns:pages="clr-namespace:UiDesktopApp1.ViewModels.Pages" d:DataContext="{d:DesignInstance Type=pages:QuanLyNguoiDungViewModel}"
             mc:Ignorable="d" 
             ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
             d:DesignHeight="60" d:DesignWidth="800">
    <Border BorderBrush="LightGray" BorderThickness="0,0,0,0.5">
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Quản lý người dùng"
                       Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="20,10,0,10"/>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding SelectedUser, Converter={x:Static beh:NullToVisibilityConverter.Instance}}">
                    <ui:Button Content="Xóa"
                               Command="{Binding DeleteCommand}"
                               Margin="0,0,10,0"
                               Appearance="Danger">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete20"
                                       
                                       FontSize="17"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Sửa"
                               Command="{Binding EditCommand}"
                               Appearance="Caution"
                               Margin="0,0,10,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Edit20"
                                       FontSize="17"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <ui:Button Content="Thêm người dùng" 
                           Command="{Binding AddCommand}"
                           Appearance="Primary"
                           MouseOverBackground="SkyBlue"
                           Margin="0,10,15,10">
                    <ui:Button.Icon>
                        <ui:SymbolIcon FontSize="17" Symbol="PersonAdd24"/>
                    </ui:Button.Icon>
                </ui:Button>
                
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
