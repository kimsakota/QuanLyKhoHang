<UserControl x:Class="UiDesktopApp1.Views.UserControls.KiemKeKhoPageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UiDesktopApp1.Views.UserControls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             xmlns:pages="clr-namespace:UiDesktopApp1.ViewModels.Pages" d:DataContext="{d:DesignInstance Type=pages:KiemKeKhoViewModel}"
             mc:Ignorable="d" 
             >
    <Border BorderBrush="LightGray" BorderThickness="0,0,0,0.5" Height="52">
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Text="Kiểm kê kho"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontSize="24"
                      FontWeight="SemiBold"
                      Margin="20,10,0,10"/>

            <ui:Button Content="Lưu phiếu" 
                   Grid.Column="1"
                   Command="{Binding SaveCheckCommand}"
                   Appearance="Primary"
                   Margin="20,10,15,10"
                   MouseOverBackground="LightBlue">
                <ui:Button.Icon>
                    <ui:SymbolIcon FontSize="17" Symbol="Save24"/>
                </ui:Button.Icon>
            </ui:Button>

        </Grid>
    </Border>
</UserControl>
