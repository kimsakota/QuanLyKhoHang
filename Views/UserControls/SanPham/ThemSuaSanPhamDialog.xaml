<UserControl x:Class="UiDesktopApp1.Views.UserControls.SanPham.ThemSuaSanPhamDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors" xmlns:sanpham="clr-namespace:UiDesktopApp1.ViewModels.Pages.SanPham" d:DataContext="{d:DesignInstance Type=sanpham:QuanLySanPhamViewModel}"
             ScrollViewer.CanContentScroll="False"
             mc:Ignorable="d" 
             d:DesignWidth="500">

    <StackPanel Margin="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <ui:Image Source="{Binding ProductImage, Mode=OneWay}" 
                                  Width="100" Height="100"
                                  Stretch="UniformToFill"
                                  CornerRadius="8"
                                  BorderBrush="Gray"
                                  BorderThickness="1"
                                  Margin="0,0,15,0"/>

                <ui:Button Content="Chọn ảnh"
                                   Icon="{ui:SymbolIcon CameraAdd24}"
                                   Appearance="Secondary"
                                   Command="{Binding OpenPictureCommand}"
                                   VerticalAlignment="Bottom"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mã sản phẩm" FontWeight="SemiBold"/>
                    <TextBlock Text=" *" Foreground="Red"/>
                </StackPanel>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding ProductForDialog.ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                        PlaceholderText="Ví dụ: SP-001"/>
                    <ui:Button Grid.Column="1" 
                               Content="Ngẫu nhiên" 
                               Margin="8,0,0,0"
                               Command="{Binding GenerateCodeCommand}"
                               Height="36"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tên sản phẩm" FontWeight="SemiBold"/>
                    <TextBlock Text=" *" Foreground="Red"/>
                </StackPanel>
                <ui:TextBox Text="{Binding ProductForDialog.ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            Margin="0,5,0,0"
                            PlaceholderText="Nhập tên sản phẩm"/>
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Số lượng ban đầu" FontWeight="SemiBold"/>
                    <ui:NumberBox Value="{Binding ProductForDialog.InitialQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,5,0,0" Minimum="0" SpinButtonPlacementMode="Compact"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Giá bán" FontWeight="SemiBold"/>
                    <ui:TextBox Text="{Binding ProductForDialog.SalePrice, Mode=TwoWay, Converter={x:Static beh:NumberVnConverter.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,5,0,0"
                                        beh:TextBoxBehaviors.SelectAllOnFocus="True"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Danh mục" FontWeight="SemiBold"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              Grid.Column="0"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ProductForDialog.CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Stretch"/>
                    <ui:Button Grid.Column="1"
                               Height="36"
                               Icon="{ui:SymbolIcon Symbol=Add24}"
                               Margin="10,0,0,0"
                               MouseOverBackground="LightBlue"
                               ToolTip="Thêm danh mục mới"
                               Command="{Binding OpenAddCategoryCommand}"/>
                </Grid>
            </StackPanel>

            <Border BorderBrush="LightBlue" 
                    BorderThickness="0.5" 
                    CornerRadius="5" 
                    Margin="0,0,0,5"
                    Visibility="{Binding IsAddingCategory, Converter={x:Static beh:BooleanToVisibilityConverter.Instance}}"
                    Background="LightGray">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tên danh mục mới" 
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <ui:Button Content="Hủy"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   MouseOverBackground="LightBlue"
                                   Command="{Binding CloseAddCategoryCommand}"
                                   Height="30"/>
                        <ui:Button Content="Lưu"
                                   Grid.Column="2"
                                   Margin="10,0,0,0"
                                   MouseOverBackground="LightBlue"
                                   Appearance="Primary"
                                   Command="{Binding AddCategoryCommand}"
                                   Height="30"/>
                    </Grid>
                    <ui:TextBox Text="{Binding NewCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Nhập tên danh mục..."/>

                    <TextBlock Text="{Binding ErrorSummary1}" 
                               Foreground="Red" 
                               Margin="0,5,0,0" 
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorSummary1, Converter={x:Static beh:StringNullOrEmptyToVisibilityConverter.Instance}}"/>  
                </StackPanel>
            </Border>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Ngày hết hạn" FontWeight="SemiBold"/>
                <Grid Margin="0,5,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:CalendarDatePicker Date="{Binding ProductForDialog.ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Grid.Column="0"
                                           FontSize="20"
                                           MouseOverBackground="LightBlue"
                                           Margin="0,0,10,0"
                                           HorizontalAlignment="Stretch"/>
                    <ui:TextBox Grid.Column="1"
                                Text="{Binding ProductForDialog.ExpiryDate, Mode=OneWay, StringFormat='dd/MM/yyyy', TargetNullValue='--/--/----'}"
                                PlaceholderText="dd/MM/yyyy"
                                IsReadOnly="True"
                                VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Mô tả" FontWeight="SemiBold"/>
                <ui:TextBox Text="{Binding ProductForDialog.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,5,0,0"
                                    AcceptsReturn="True" Height="60"
                                    PlaceholderText="Nhập mô tả chi tiết..."/>
            </StackPanel>
        </StackPanel>

        <ui:InfoBar Margin="0,10,0,0"
                        Severity="Error"
                        Title="Dữ liệu chưa hợp lệ"
                        Message="{Binding ErrorSummary, Mode=OneWay}"
                        IsOpen="{Binding ProductForDialog.HasErrors}"
                        IsClosable="False"/>

        <ui:InfoBar Margin='0,5,0,0'
                        Severity="Informational"
                        Message="Đang xử lý..."
                        IsOpen="{Binding IsBusy}"
                        IsClosable="False" />
    </StackPanel>
</UserControl>