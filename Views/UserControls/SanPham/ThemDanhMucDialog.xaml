<UserControl x:Class="UiDesktopApp1.Views.UserControls.SanPham.ThemDanhMucDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             d:DesignWidth="400">

    <StackPanel Margin="10">
        <TextBlock Text="Tên danh mục mới" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ui:TextBox Text="{Binding NewCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Nhập tên danh mục..."/>

        <TextBlock Text="{Binding ErrorSummary}" 
                   Foreground="Red" 
                   Margin="0,5,0,0" 
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorSummary, Converter={x:Static beh:StringNullOrEmptyToVisibilityConverter.Instance}}"/>
    </StackPanel>
</UserControl>