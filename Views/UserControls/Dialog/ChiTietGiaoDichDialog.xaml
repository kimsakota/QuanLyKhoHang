<UserControl x:Class="UiDesktopApp1.Views.UserControls.Dialog.ChiTietGiaoDichDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:UiDesktopApp1.Behaviors" 
             mc:Ignorable="d"
             ScrollViewer.CanContentScroll="False"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             d:DesignWidth="700" d:DesignHeight="400">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" Background="{ui:ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Mã phiếu" Opacity="0.6" FontSize="12"/>
                    <TextBlock Text="{Binding TransactionCode}" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="{Binding PartnerName}" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Creator}" Opacity="0.8" Margin="0,5,0,0" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <ui:DataGrid Grid.Row="1" Margin="0,16"
                     ItemsSource="{Binding Details}"
                     CanUserResizeColumns="False"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     
                     Visibility="{Binding Details.Count, Converter={x:Static beh:ZeroToCollapsedConverter.Instance}}"
                     AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Mã SP" Binding="{Binding ProductCode}" Width="90"/>
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="110" FontWeight="Bold"/>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <ui:DataGrid Grid.Row="1" Margin="0,16"
                     ItemsSource="{Binding InventoryDetails}"
                     Visibility="{Binding InventoryDetails.Count, Converter={x:Static beh:ZeroToCollapsedConverter.Instance}}"
                     AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Mã SP" Binding="{Binding ProductCode}" Width="90"/>
                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Tồn hệ thống" Binding="{Binding SystemQty}" Width="100"/>
                <DataGridTextColumn Header="Tồn thực tế" Binding="{Binding ActualQty}" Width="100" FontWeight="Bold"/>

                <DataGridTemplateColumn Header="Chênh lệch" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Diff}" FontWeight="Bold" 
                                       Foreground="{Binding Diff, Converter={x:Static beh:NumberToColorConverter.Instance}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding TotalAmount, Converter={x:Static beh:NullToVisibilityConverter.Instance}}">
            <TextBlock Text="TỔNG TIỀN:" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} VNĐ}" 
                       FontSize="20" FontWeight="Bold" 
                       />
        </StackPanel>
    </Grid>
</UserControl>