<UserControl x:Class="UiDesktopApp1.Views.UserControls.Dialog.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UiDesktopApp1.Views.UserControls.Dialog"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:UiDesktopApp1.Helpers"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             xmlns:viewmodels="clr-namespace:UiDesktopApp1.ViewModels.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>
    <StackPanel MinWidth="350" Margin="8">

        <ui:CardControl>
            <ui:CardControl.Header>
                <TextBlock Text="Cá nhân hóa" FontWeight="SemiBold" FontSize="16"/>
            </ui:CardControl.Header>

            <StackPanel Margin="8,8,8,12">
                <TextBlock Text="Giao diện (Theme)" Margin="0,0,0,8" Opacity="0.8"/>
                <RadioButton
                    Margin="0,8,0,0"
                    Command="{Binding ChangeThemeCommand, Mode=OneWay}"
                    CommandParameter="theme_light"
                    Content="Sáng"
                    GroupName="themeSelect"
                    IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
                <RadioButton
                    Margin="0,8,0,0"
                    Command="{Binding ChangeThemeCommand, Mode=OneWay}"
                    CommandParameter="theme_dark"
                    Content="Tối"
                    GroupName="themeSelect"
                    IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,16,0,0">
            <ui:CardControl.Header>
                <TextBlock Text="Về ứng dụng" FontWeight="SemiBold" FontSize="16"/>
            </ui:CardControl.Header>

            <StackPanel Margin="8,8,8,12">
                <TextBlock Text="Phiên bản" Margin="0,0,0,4" Opacity="0.8"/>
                <TextBlock Text="{Binding AppVersion, Mode=OneWay}" />
            </StackPanel>
        </ui:CardControl>

    </StackPanel>
</UserControl>
